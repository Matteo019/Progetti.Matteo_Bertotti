# Copy to .env on the server (never commit it). See DEPLOY.md.

# Postgres password for the site database
POSTGRES_PASSWORD=change-me

# Admin login for /admin
ADMIN_USERNAME=matteo
# bcrypt hash of the admin password, generated with api/tools/hash_password.py
# In .env every $ must be written as $$ (Docker Compose interpolation)
ADMIN_PASSWORD_HASH=

# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
