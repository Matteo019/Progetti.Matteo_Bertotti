# Copy this file to .env (on the server, next to docker-compose.yaml).

# Database password: choose a long random one, e.g. with:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Demo account for visitors (admin / admin). It can edit products but not manage users.
# Set DEMO_ENABLED=false to turn it off.
DEMO_ENABLED=true
DEMO_USERNAME=admin
DEMO_PASSWORD=admin
